{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60,
      "description": "프로필 이름. 최대 60자."
    },
    "caption": {
      "default": "a collection of little joys",
      "description": "페이지 맨 위 문구. 빈 값이면 숨깁니다.",
      "type": "string",
      "maxLength": 80
    },
    "eyebrow": {
      "description": "프로필 이름 위 보조 문구. 생략하거나 빈 값이면 숨깁니다.",
      "type": "string",
      "maxLength": 120
    },
    "bio": {
      "description": "소개 문구. 줄바꿈을 지원하며 최대 240자. 생략하면 숨깁니다.",
      "type": "string",
      "maxLength": 240
    },
    "avatar": {
      "description": "선택적인 프로필 이미지. 생략하면 이미지 영역을 숨깁니다.",
      "type": "string",
      "pattern": "^(?:[a-zA-Z0-9_-]+\\/)*[a-zA-Z0-9_-]+\\.(svg|png|jpe?g|webp|avif)$",
      "examples": [
        "media/products/cushion.webp"
      ]
    },
    "avatarAlt": {
      "description": "프로필 이미지 설명. 생략하면 이름을 사용한 기본 설명을 표시합니다.",
      "type": "string",
      "maxLength": 160
    },
    "tagsLabel": {
      "default": "관심사",
      "description": "관심사 목록의 접근 가능한 이름.",
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "tags": {
      "default": [],
      "description": "최대 6개, 각 24자의 관심사. 중복 없이 #을 제외한 문구를 작성하세요. 빈 배열이면 숨깁니다.",
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 24
      }
    },
    "socials": {
      "type": "object",
      "properties": {
        "label": {
          "default": "SNS 바로가기",
          "description": "SNS 탐색 영역의 접근 가능한 이름.",
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "items": {
          "default": [],
          "description": "표시 순서대로 정의한 SNS. 노출 항목이 없으면 탐색 영역을 숨깁니다.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$",
                "description": "SNS·기본 링크·상품 전체에서 유일한 ID. 제목·주소·순서를 바꿔도 유지합니다.",
                "examples": [
                  "shop-cushion-01"
                ]
              },
              "destination": {
                "description": "site.json의 destinations 키를 참조합니다. destination 또는 url 중 하나는 필요합니다.",
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$",
                "examples": [
                  "shop-cushion-01"
                ]
              },
              "url": {
                "description": "직접 지정한 HTTPS 주소. destination과 함께 쓰면 공통 주소를 덮어씁니다.",
                "type": "string",
                "format": "uri",
                "examples": [
                  "https://example.com/product/cushion"
                ]
              },
              "platform": {
                "description": "개별 아이콘. 생략하면 공통 목적지의 platform을 쓰고, 직접 URL만 있으면 website를 씁니다.",
                "type": "string",
                "enum": [
                  "instagram",
                  "tiktok",
                  "youtube",
                  "website"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60,
                "description": "아이콘 링크의 접근 가능한 이름과 툴팁."
              },
              "enabled": {
                "default": true,
                "description": "false면 해당 SNS를 숨깁니다.",
                "type": "boolean"
              },
              "openInNewTab": {
                "default": false,
                "description": "true면 새 탭에서 엽니다.",
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "label"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false,
      "description": "프로필 아래의 SNS 아이콘 목록과 안내 이름."
    }
  },
  "required": [
    "name",
    "socials"
  ],
  "additionalProperties": false
}
